<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Must match the plugin's TFM and architecture: a net8.0/AnyCPU test project
         cannot ProjectReference a net8.0-windows/x64 one. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The plugin's AutoCAD references are <Private>false</Private>, so acmgd.dll and
       friends are never copied here. That is the point: the test host has no AutoCAD
       in it, so anything reachable from a test must be free of AutoCAD types. Code
       that touches the database belongs behind that boundary, not in front of it. -->
  <ItemGroup>
    <ProjectReference Include="..\Wang_MCP_AutoCAD\Wang_MCP_AutoCAD.csproj" />
  </ItemGroup>

</Project>
