<Project>

  <!--
    Machine-local settings live in deploy.local.props, which is gitignored so that no
    absolute path from a developer's machine ends up in the repository. Copy
    deploy.local.props.example alongside it and edit that copy.

    This file is imported automatically by every project in the tree, so both the plugin
    and the Loader pick up WangMcpDeployDir without repeating the import.
  -->
  <Import Project="$(MSBuildThisFileDirectory)deploy.local.props"
          Condition="Exists('$(MSBuildThisFileDirectory)deploy.local.props')" />

</Project>
